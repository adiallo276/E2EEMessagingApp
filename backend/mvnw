# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.4
# ----------------------------------------------------------------------------

set -e

# Find the project basedir
findMavenBasedir() {
  basedir=$(dirname "$0")
  wdir="$basedir"
  while [ "$wdir" != '/' ]; do
    if [ -d "$wdir"/.mvn ]; then
      basedir=$wdir
      break
    fi
    wdir=$(cd "$wdir/.." && pwd)
  done
  printf '%s' "$(cd "$basedir" && pwd)"
}

BASE_DIR=$(findMavenBasedir)
MAVEN_PROJECTBASEDIR=${MAVEN_BASEDIR:-"$BASE_DIR"}

MAVEN_OPTS="${MAVEN_OPTS:--Xmx1024m}"

WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

if [ -f "$WRAPPER_PROPERTIES" ]; then
  DISTRIBUTION_URL=$(grep distributionUrl "$WRAPPER_PROPERTIES" | cut -d'=' -f2)
else
  echo "ERROR: Cannot find .mvn/wrapper/maven-wrapper.properties"
  exit 1
fi

# Distribution directory
MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"
MAVEN_WRAPPER_HOME="$MAVEN_USER_HOME/wrapper"
DISTRIBUTION_ID=$(echo "$DISTRIBUTION_URL" | sed 's|.*/||' | sed 's|-bin\.zip||')
MAVEN_HOME="$MAVEN_WRAPPER_HOME/dists/$DISTRIBUTION_ID"

if [ ! -d "$MAVEN_HOME" ] || [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  echo "Downloading Apache Maven from $DISTRIBUTION_URL"
  mkdir -p "$MAVEN_WRAPPER_HOME/dists"
  TEMP_ZIP="$MAVEN_WRAPPER_HOME/dists/maven-download-$$.zip"

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$TEMP_ZIP" "$DISTRIBUTION_URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$TEMP_ZIP" "$DISTRIBUTION_URL"
  else
    echo "ERROR: Neither curl nor wget found. Please install Maven manually."
    exit 1
  fi

  echo "Extracting Maven..."
  unzip -q "$TEMP_ZIP" -d "$MAVEN_WRAPPER_HOME/dists"
  rm -f "$TEMP_ZIP"

  # The zip extracts to a directory named after the distribution
  EXTRACTED=$(find "$MAVEN_WRAPPER_HOME/dists" -maxdepth 1 -name "apache-maven-*" -type d | sort | tail -1)
  if [ -z "$EXTRACTED" ]; then
    echo "ERROR: Failed to extract Maven distribution"
    exit 1
  fi
  MAVEN_HOME="$EXTRACTED"
fi

MAVEN_CMD="$MAVEN_HOME/bin/mvn"

if [ ! -x "$MAVEN_CMD" ]; then
  chmod +x "$MAVEN_CMD"
fi

exec "$MAVEN_CMD" "$@"
